{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trackers",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackers-db",
      "database_id": "6be36860-f127-4ff1-bcd5-4e8621f678bd",
      "migrations_dir": "./migrations"
    }
  ],
  // Checks reminders every minute.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BNYrLQysbnP2XDJWIRmoISR2a8VQA_mbIfUDo1CBICI2ZmnLrpKIL1vqwR8opqei-nvAjr4rbggZgGUXeKteCoU",
    "VAPID_SUBJECT": "https://trackers.vectorvarma0303.workers.dev"
  },
  "observability": { "enabled": true }
  // Secrets (not in this file): APP_PASSWORD, VAPID_PRIVATE_JWK
}
